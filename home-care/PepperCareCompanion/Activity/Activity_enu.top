topic: ~Activity()
language: enu

# Pepper Care Companion v4.0 (IEEE Malta Digital Health Hackathon 2026). Any number of patients, one at a time.
# ASCII only. Keep robot lines short.

concept:(yes) [yes yeah yep sure okay ok please "of course" "go ahead"]
concept:(no) [no nope "no thanks" "not yet" forgot "i forgot" "i did not" "i didn't"]
concept:(notSure) ["not sure" "don't know" "do not know" maybe]
concept:(happy) [good fine great happy "not bad" "very good" "pretty good"]
concept:(sad) [sad bad tired sick unwell lonely pain "not good" "not well" "not great"]
concept:(how) ["how are you" "and you"]
concept:(repeat) [repeat again "say again" pardon]
concept:(thx) [thanks "thank you"]
concept:(hello) [hello hi hey "good morning" "good afternoon" "good evening"]
concept:(bye) [bye goodbye "see you"]
concept:(exercise) [exercise exercises workout]
concept:(next) [next skip]
concept:(back) [back previous "go back"]
concept:(done) [done finished]
concept:(stop) [stop enough halt "stop pepper"]
concept:(dance) [dance dancing]
concept:(activities) [activities activity "an activity" "some activities"]
concept:(snl) [snakes ladders "snakes and ladders" "snake and ladder" "snakes and ladder" "snakes ladders" "board game" game games "a game" "play a game"]
concept:(rollDice) [roll "roll the dice" "roll dice" "throw the dice" "throw dice" dice throw]
concept:(skipTurn) [skip "skip turn" "skip my turn"]
concept:(newGame) ["new game" "start over" "play again" restart "another game"]
concept:(quiz) [quiz quizzes trivia "play a quiz" "ask me questions"]
concept:(ansOne) [one first "number one" "option one" "the first one" "the first"]
concept:(ansTwo) [two second "number two" "option two" "the second one" "the second"]
concept:(ansThree) [three third "number three" "option three" "the third one" "the third"]
concept:(memW1) [band bands "on a boat" aboard sailed inside indoors ricotta irkotta walls fortress stone tomato tomatoes "olive oil" crib nativity costumes costume swimming swim balcony balconies]
concept:(memW2) [fireworks firework shore watched "from the shore" deck outside outdoors peas pizelli boats ships butter food sweets dinner floats float parade walk strolling street played]
concept:(relive) [memories memory "malta memories" "relive malta" "remember malta" reminisce]
concept:(music) [music song songs]
concept:(chat) [chat talk conversation]
concept:(breathe) [breathe breathing "deep breath" "deep breathing" relax calm]
concept:(medTime) ["when is my medicine" "when is my medication" "medicine time" "medication time"]
concept:(medication) [medication medicine medicines pills]
concept:(reminder) [reminder remind]
concept:(help) [help emergency nurse "i need help"]
concept:(suggest) ["surprise me" "something fun" "something nice" "i am bored" bored "you choose" "you decide" "what do you suggest" "what do you recommend" suggest suggestion "any idea" "any ideas" "i do not know" "i don't know" "not sure"]
concept:(nextPatient) ["next patient" "next person"]
concept:(group) ["all of us" "we are two" "we are three" "we are four" "we are many" "our group"]
concept:(hourWord) [one two three four five six seven eight nine ten eleven twelve]
concept:(minWord) [one two three five ten fifteen twenty thirty]
concept:(am) [morning "a m" am]
concept:(pm) [afternoon evening night "p m" pm]
concept:(names) [Anna Ben Carl David Emma Frank Grace Hannah Ian Julia Karl Laura Mark Nina Oscar Paul Rachel Sarah Tom Vera Adam Alice Amy Andrew Anne Benjamin Charlotte Chris Daniel Elena Emily Erik Eva George Helen Henry Isabel Jack James Jan Jennifer John Joseph Katherine Kevin Lisa Lucy Maria Mary Michael Natalie Nora Olivia Patrick Peter Robert Ruth Sofia Sophie Stephen Susan Thomas Victoria William Zoe Ali Amir Fatima Hassan Priya Raj Ankit Ravi Sunita Wei Mei Yuki Ola Lars Ingrid Kari Magnus Silje Sondre Sven Tone Astrid Joe Jane Jean Carmen Charles Mario Miriam Paolo Lorna Doreen Carmel Carmela Rita Rose Josephine Antoinette Frances Francis Anthony Tony Salvu Salvatore Emanuel Lawrence Censu Nazzareno Giuseppe Giovanni Pawlu Pauline Marthese Mariella Marija Doris Joanna Christine Claire Conrad Duncan Edward Albert Alfred Arthur Barbara Betty Brian Catherine Clara Diana Dorothy Eleanor Elizabeth Ellen Eric Ethel Evelyn Florence Frederick Gerald Gloria Gordon Harold Harry Irene Jacob Joan Joyce Judith Kenneth Leonard Lily Louis Louise Margaret Martha Martin Maureen Mildred Nancy Norman Pamela Patricia Philip Ralph Raymond Richard Roger Ronald Rosa Samuel Shirley Simon Stanley Teresa Theresa Vincent Walter Wendy Agnes Alan Bernard Beatrice Colin Dennis Derek Edith Edna Geoffrey Gwen Hilda Ivy Jessie Kathleen Keith Leslie Malcolm Marion Maud Muriel Neil Nellie Olive Percy Phyllis Reginald Sidney Sylvia Trevor Una Violet Winifred Bjorn Knut Liv Solveig Gunnar Arne Odd Randi Berit Hilde Eirik Torstein Kristin Marit Anders Per Nils Petter Hans Sigrid Tove Aksel Emil Jonas Ida Ingeborg Oda Maja Sara Leah Noah Liam Mia Ella Ava Chloe]
dynamic:extraNames

# ----- sent by the Care Controller (ALDialog.forceInput) ---------------------------
u:("robotcmd crowd") Hello everyone! One at a time, please. You can add your name on my tablet. ^stayInScope
u:("robotcmd registered") ^gotoReactivate(nameKnown)
u:("robotcmd registeredfirst") ^gotoReactivate(nameFirst)
u:("robotcmd askname") ^gotoReactivate(askName)
u:("robotcmd callnext") ^gotoReactivate(callNext)
u:("robotcmd closed") Thank you. Goodbye!
u:("robotcmd meddue") ^gotoReactivate(medDue)
u:("robotcmd breathdone") ^gotoReactivate(breatheEnd)
u:("robotcmd exdone1") Well done! ^gotoReactivate(exercise2)
u:("robotcmd exdone2") Well done! ^gotoReactivate(exercise3)
u:("robotcmd exdone3") Well done! ^gotoReactivate(exercise4)
u:("robotcmd exdone4") Well done! ^gotoReactivate(exercise5)
u:("robotcmd exdone5") Well done! ^gotoReactivate(exercise6)
u:("robotcmd exdone6") Well done! ^gotoReactivate(exercise7)
u:("robotcmd exdone7") Well done! ^gotoReactivate(exercise8)
u:("robotcmd exdone8") Well done! ^gotoReactivate(exercise9)
u:("robotcmd exdone9") Well done! ^gotoReactivate(endExercise)
u:("robotcmd tilea") ^gotoReactivate(exerciseIntro)
u:("robotcmd tileb") ^gotoReactivate(chooseSong)
u:("robotcmd tilec") ^gotoReactivate(chatQ1)
u:("robotcmd tiled") ^gotoReactivate(medCheck)
u:("robotcmd tilee") ^gotoReactivate(dancePlay)
u:("robotcmd tilef") ^gotoReactivate(breatheIntro)
u:("robotcmd tileg") ^gotoReactivate(reminderAsk)
u:("robotcmd tileh") ^gotoReactivate(callHelp)
u:("robotcmd tilei") ^gotoReactivate(memStart)
u:("robotcmd tilek") ^gotoReactivate(quizStart)
u:("robotcmd tilel") ^gotoReactivate(saxPlay)
u:("robotcmd tilem") ^gotoReactivate(song1Play)
u:("robotcmd tilen") ^gotoReactivate(song2Play)
u:("robotcmd tileo") ^gotoReactivate(song3Play)
u:("robotcmd tilep") ^gotoReactivate(chooseActivity)
u:("robotcmd tileq") ^gotoReactivate(snlStart)
u:("robotcmd quizask") ^gotoReactivate(quizAsk)
u:("robotcmd quizend") ^gotoReactivate(quizEnd)
u:("robotcmd quizidle") Okay, no more questions for now. ^gotoReactivate(anythingElse)
u:("robotcmd memcard") ^gotoReactivate(memCard)
u:("robotcmd memend") ^gotoReactivate(memEnd)
u:("robotcmd memidle") Okay. ^gotoReactivate(anythingElse)
u:("robotcmd snlsay") ^gotoReactivate(snlSay)
u:("robotcmd snlend") ^gotoReactivate(snlEnd)
u:("robotcmd snlidle") Okay. ^gotoReactivate(anythingElse)
u:("robotcmd welcome") ^start(animations/Stand/Gestures/Hey_1) Hello! ^wait(animations/Stand/Gestures/Hey_1) ^gotoReactivate(welcome)
u:("robotcmd ping") $dlgPong=ok4
u:("robotcmd hellosame") Hello again, $name! ^gotoReactivate(anythingElse)
u:("robotcmd grouphere") One at a time, please. Who is first? ^gotoReactivate(askName)
u:("robotcmd saytext") $sayText ^stayInScope
u:("robotcmd later") Let us finish this first. ^stayInScope
u:("robotcmd hintquiz") Say one, two, or three. Or touch the screen. ^stayInScope
u:("robotcmd hintmem") Say the first or the second. Say next to see another picture. Or touch the screen. ^stayInScope
u:("robotcmd hintsnl") Say roll to throw the dice. Or touch the dice. ^stayInScope
u:("robotcmd hintex") Just follow my movements. Say next to skip, or stop to end. ^stayInScope
u:("robotcmd hintbreath") Breathe in and out with me. Say stop when you want to end. ^stayInScope
u:("robotcmd hintmusic") Enjoy the music. Say stop when you want something else. ^stayInScope
u:("robotcmd hintidle") You can say exercise, breathing, music, activities, chat, memories, medicine, or reminder. You can also ask me the time, or for a joke. ^stayInScope
u:("robotcmd suggestask") ^gotoReactivate(suggestAsk)
u:("robotcmd suggestnone") That is all my ideas for now. Tell me what you would like. ^gotoReactivate(offerMenuAgain)
u:("robotcmd didmean") ^gotoReactivate(didMean)
u:("robotcmd nuplain") Sorry, I did not catch that. ^gotoReactivate(offerMenuAgain)
u:("robotcmd nutouch") Sorry. You can also touch my screen. ^gotoReactivate(offerMenuAgain)


# ----- things a person can say at any time ----------------------------------------
u:(~hello) $pepperCmd=hello ^stayInScope
u:(~nextPatient) Okay. Next person, please. $pepperCmd=next
u:(~group) $pepperCmd=group ^stayInScope
u:(~help) ^gotoReactivate(callHelp)
u:(~stop) Okay, I stopped. $pepperCmd=stop
u:(~medTime) Your reminder is at $medNext.
u:(~reminder) ^gotoReactivate(reminderAsk)
u:(~medication) ^gotoReactivate(medCheck)
u:(what is your name) My name is Pepper.
u:(~how) I am fine, thank you!
u:(~thx) You are welcome!
u:(~bye) Goodbye! Take care.
u:([color colour]) My favourite colour is violet.
u:(do you eat) No. I eat electricity!
u:(e:LeftBumperPressed) My left foot bumped into something!
u:(e:RightBumperPressed) My right foot bumped into something!
u:(~repeat) ^sameProposal
u:(["i fell" "i have fallen" "i fell down" "i have had a fall" "i had a fall" "i have fallen down"]) Please stay where you are. I am calling the care staff now. $pepperCmd=needfall ^stayInScope
u:(["i am in pain" "i have a pain" "it hurts" "that hurts" "i am hurting" "i have chest pain" "my chest hurts" "i have pain"]) I am sorry. I am calling the care staff now. $pepperCmd=needpain ^stayInScope
u:(["i feel dizzy" "i am dizzy" "i feel faint" "i feel sick" "i am going to faint"]) Please sit down. I am calling the care staff now. $pepperCmd=needdizzy ^stayInScope
u:(["i cannot breathe" "i can not breathe" "i can't breathe" "i am short of breath" "i have trouble breathing"]) Stay calm. I am calling the care staff now. $pepperCmd=needbreath ^stayInScope
u:(["i need the toilet" "i need to go to the toilet" "i need the bathroom" "i need the loo" "where is the toilet" "i want the toilet" "i need to use the toilet"]) Of course. I will tell the care staff. They will come soon. $pepperCmd=needtoilet ^stayInScope
u:(["i am thirsty" "i want a drink" "i would like a drink" "i need a drink" "i want some water" "can i have some water" "a cup of tea please"]) I will ask the care staff for a drink. $pepperCmd=needdrink ^stayInScope
u:(["i am hungry" "i want something to eat" "i would like something to eat"]) I will tell the care staff that you are hungry. $pepperCmd=needfood ^stayInScope
u:(["i am cold" "i feel cold" "i am freezing"]) I will tell the care staff that you are cold. $pepperCmd=needcold ^stayInScope
u:(["i am hot" "i feel hot" "i am too hot"]) I will tell the care staff that you are hot. $pepperCmd=needhot ^stayInScope
u:(["i am lonely" "i feel lonely" "i am sad" "i feel sad" "i feel low" "i am unhappy"]) I am sorry you feel that way. I am here with you. Say chat or music, and I will do that. $pepperCmd=moodlow ^stayInScope
u:(["what can you do" "what can i say" "what do i say" "how do i use you" "i do not understand" "i don't understand"]) $pepperCmd=helpme ^stayInScope
u:(["what time is it" "what is the time" "tell me the time" "do you know the time" "what time is it now"]) It is $clockText. ^stayInScope
u:(["what day is it" "what day is today" "what is the date" "what is today" "what is today's date"]) Today is $dayText. ^stayInScope
u:(["tell me a joke" "do you know a joke" "make me laugh" "another joke" "say a joke"]) $pepperCmd=joke ^stayInScope
u:(["tell me about malta" "tell me a fact" "tell me something" "something about malta" "a malta fact" "did you know"]) $pepperCmd=fact ^stayInScope
u:(["surprise me" "i am bored" "something fun" "what do you suggest" "you choose"]) $pepperCmd=suggest ^stayInScope
u:(["who are you" "what are you"]) I am Pepper, a robot. I am here to keep you company. ^stayInScope
u:(["are you a robot" "are you real" "are you alive"]) Yes, I am a robot. I am not alive, but I am happy to be with you. ^stayInScope
u:(["do you sleep"]) Robots do not sleep. I am always ready to talk. ^stayInScope
u:(["where do you live" "where are you from"]) I live here with you. ^stayInScope
u:(["you are nice" "you are kind" "i like you" "you are good" "you are funny" "you are clever"]) Thank you, that is kind of you! ^stayInScope

# ----- 1. name --------------------------------------------------------------------------

proposal: %autoStart $pepperCmd=autostart

proposal: %welcome I am Pepper, your activity companion. I can help you exercise and breathe, play music and activities, chat, relive memories of Malta, and look after your medicine and reminders. ^gotoReactivate(askName)

proposal: %askName What is your first name?
